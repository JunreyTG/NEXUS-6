# ==============================================================================
# DataVault6 / NEXUS-6 Environment Configuration Template (.env.example)
# ==============================================================================

# Core Application & Network
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:8081
APP_BASE_URL=

# Primary PostgreSQL System Database (Docker host port 5434)
SYSTEM_DATABASE_URL=postgresql://postgres:Password123!@localhost:5434/nexus6_db
SYSTEM_DATABASE_DIRECT_URL=postgresql://postgres:Password123!@localhost:5434/nexus6_db
POSTGRES_SYSTEM_DB=nexus6_db
POSTGRES_SYSTEM_USER=postgres
POSTGRES_SYSTEM_PASSWORD=Password123!
POSTGRES_SYSTEM_PORT=5434

# Append-Only Activity Log Database (Docker host port 5435)
LOG_DATABASE_URL=postgresql://postgres:Password123!@localhost:5435/nexus_logs
POSTGRES_LOGS_DB=nexus_logs
POSTGRES_LOGS_USER=postgres
POSTGRES_LOGS_PASSWORD=Password123!
POSTGRES_LOGS_PORT=5435

# Super Admin & Authentication
SUPER_ADMIN_EMAIL=admin@datavault6.local
SUPER_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$Sb4hP1AD7hGOUPiTxE3jMQ$M5Ih7gGIBMzPlXkjJm73xIg5FLvxcDBiM+XS/5RiOe8'
ACCESS_TOKEN_SECRET=replace_with_a_secure_random_base64_secret_minimum_32_bytes==
ACCESS_TOKEN_EXPIRES_IN=10m
REFRESH_TOKEN_EXPIRES_DAYS=30

# File Upload Settings (0 = unlimited GB upload)
MAX_UPLOAD_SIZE_MB=0
TEMP_UPLOAD_DIR=
TEMP_UPLOAD_RETENTION_HOURS=24

# Email Provider Settings (console | brevo | brevos)
EMAIL_PROVIDER=brevos
EMAIL_FROM="DataVault6 <noreply@localhost>"
BREVO_API_KEY=
BREVO_SMTP_KEY=
BREVO_SMTP_USER=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DataVault6
VERIFICATION_TOKEN_EXPIRES_HOURS=24
PASSWORD_SETUP_TOKEN_EXPIRES_MINUTES=30

# ==============================================================================
# Firebase Users Database & Authentication
# ==============================================================================
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ==============================================================================
# Multi-Engine Database Configurations (Host-mapped Docker ports)
# ==============================================================================

# 1. MySQL (Relational)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nexus_db
MYSQL_USER=nexus
MYSQL_PASSWORD=Nexus6MySQL!2026

# 2. PostgreSQL Data Engine
POSTGRES_DATA_HOST=localhost
POSTGRES_DATA_PORT=5434
POSTGRES_DATA_DATABASE=nexus6_db
POSTGRES_DATA_USER=postgres
POSTGRES_DATA_PASSWORD=Password123!
POSTGRES_DATA_SSL=false

# 3. Microsoft SQL Server (Relational)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=nexus6_public_data
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrongPassword123!
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# 4. MongoDB (Document)
MONGODB_URI=mongodb://admin:admin1234@localhost:27017/nexus-6?authSource=admin
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin1234
MONGO_INITDB_DATABASE=nexus-6

# 5. Couchbase (Document / Key-Value)
COUCHBASE_CONNECTION_STRING=couchbase://localhost
COUCHBASE_USERNAME=jul123
COUCHBASE_PASSWORD=123456
COUCHBASE_BUCKET=itd100
COUCHBASE_CLUSTER=ITD100

# 6. Neo4j (Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=passw0rd1222
