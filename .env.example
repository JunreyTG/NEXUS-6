# ==========================================
# DataVault6 Environment Configuration
# ==========================================

NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:8080

# ==========================================
# Database Connection Options
# ==========================================
# OPTION A: Host-run backend connecting to Docker-mapped localhost ports
# - postgres-system mapped to localhost:5434
# - postgres-logs mapped to localhost:5435
SYSTEM_DATABASE_URL="postgresql://postgres:Password123!@localhost:5434/nexus_system"
SYSTEM_DATABASE_DIRECT_URL="postgresql://postgres:Password123!@localhost:5434/nexus_system"
LOG_DATABASE_URL="postgresql://postgres:Password123!@localhost:5435/nexus_logs"

# OPTION B: Containerized backend connecting through Docker network service names
# SYSTEM_DATABASE_URL="postgresql://postgres:Password123!@postgres-system:5432/nexus_system"
# SYSTEM_DATABASE_DIRECT_URL="postgresql://postgres:Password123!@postgres-system:5432/nexus_system"
# LOG_DATABASE_URL="postgresql://postgres:Password123!@postgres-logs:5432/nexus_logs"

# ==========================================
# Super Admin & Auth Credentials
# ==========================================
SUPER_ADMIN_EMAIL=admin@datavault6.local
SUPER_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$Sb4hP1AD7hGOUPiTxE3jMQ$M5Ih7gGIBMzPlXkjJm73xIg5FLvxcDBiM+XS/5RiOe8'

ACCESS_TOKEN_SECRET=replace_with_a_secure_random_base64_secret_minimum_32_bytes==
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

EMAIL_PROVIDER=brevos
EMAIL_FROM=DataVault6 <daplinankaila91@gmail.com>
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=daplinankaila91@gmail.com
BREVO_SENDER_NAME=DataVault6

VERIFICATION_TOKEN_EXPIRES_HOURS=24
PASSWORD_SETUP_TOKEN_EXPIRES_MINUTES=30
# Maximum accepted upload size in megabytes (0 = unlimited GB upload)
MAX_UPLOAD_SIZE_MB=0
TEMP_UPLOAD_DIR=
TEMP_UPLOAD_RETENTION_HOURS=24

# ==========================================
# Multi-Engine Database Configurations (Docker)
# ==========================================
# 1. MySQL (Host: localhost:3306 | Docker: mysql:3306)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nexus_db
MYSQL_USER=nexus
MYSQL_PASSWORD=Nexus6MySQL!2026

# 2. PostgreSQL Data Engine (Host: localhost:5432 | Docker: postgres-system:5432)
POSTGRES_DATA_HOST=localhost
POSTGRES_DATA_PORT=5432
POSTGRES_DATA_DATABASE=nexus_system
POSTGRES_DATA_USER=postgres
POSTGRES_DATA_PASSWORD=Password123!
POSTGRES_DATA_SSL=false

# 3. Microsoft SQL Server (Host: localhost:1433 | Docker: sqlserver:1433)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=nexus6_public_data
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrongPassword123!
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# 4. MongoDB (Host: localhost:27017 | Docker: mongodb:27017)
MONGODB_URI=mongodb://root:Nexus6Mongo!2026@localhost:27017/nexus-6?authSource=admin

# 5. Couchbase (Host: localhost | Docker: couchbase)
COUCHBASE_CONNECTION_STRING=couchbase://localhost
COUCHBASE_USERNAME=nexus6
COUCHBASE_PASSWORD=Mystery@02
COUCHBASE_BUCKET=travel-sample

# 6. Neo4j (Host: bolt://localhost:7687 | Docker: bolt://neo4j:7687)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=xu698WnpSb-vy5a2ShXuSqDfkA6oVcYFq5qMxJgwGFY
