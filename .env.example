NODE_ENV=
API_PORT=
WEB_ORIGIN=

# Neon pooled/runtime connection for the API
SYSTEM_DATABASE_URL=
# Neon direct connection for Prisma migrations
SYSTEM_DATABASE_DIRECT_URL=

# Separate PostgreSQL database for append-only system activity logs.
LOG_DATABASE_URL=

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=

ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_DAYS=

EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
# Optional token lifetimes. Defaults are 24 hours and 30 minutes.
VERIFICATION_TOKEN_EXPIRES_HOURS=24
PASSWORD_SETUP_TOKEN_EXPIRES_MINUTES=30
# 0 = unlimited file size
MAX_UPLOAD_SIZE_MB=0
TEMP_UPLOAD_DIR=
TEMP_UPLOAD_RETENTION_HOURS=24

# Optional public dataset database connections. Leave blank when unconfigured.
MONGODB_URI=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
POSTGRES_DATA_HOST=
POSTGRES_DATA_PORT=5432
POSTGRES_DATA_DATABASE=
POSTGRES_DATA_USER=
POSTGRES_DATA_PASSWORD=
POSTGRES_DATA_SSL=true
COUCHBASE_CONNECTION_STRING=
COUCHBASE_USERNAME=
COUCHBASE_PASSWORD=
COUCHBASE_BUCKET=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=false
